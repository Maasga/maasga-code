{
  "name": "maasga-website",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "build:css": "npx tailwindcss -i src/styles/app.css -o public/static/tailwind.css --minify",
    "build": "npm run build:css && vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name maasga-website",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "migrate": "wrangler d1 migrations apply maasga_db --remote",
    "migrate:local": "wrangler d1 migrations apply maasga_db --local",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl http://localhost:3000"
  },
  "dependencies": {
    "hono": "^4.12.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260302.0",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vite": "^6.3.5",
    "wrangler": "^4.73.0"
  }
}
