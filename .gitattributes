# Fins de ligne normalisées : LF dans le dépôt ET dans l'arbre de travail,
# quel que soit core.autocrlf (évite les fichiers mixtes CRLF/LF sous Windows).
* text=auto eol=lf

# Scripts Windows : CRLF obligatoire
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaires (jamais de conversion ni de diff texte)
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.ttf  binary
*.woff binary
*.woff2 binary
*.mp4  binary
*.webm binary
*.pyc  binary
*.zip  binary
